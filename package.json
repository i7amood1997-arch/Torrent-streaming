{
  "name": "torrent-streaming",
  "version": "0.1.0",
  "private": true,
  "description": "Static PWA (GitHub Pages) + Cloudflare Worker API: TMDB discovery, direct torrent search, Debrid/WebTorrent playback, Arabic/English subtitles.",
  "scripts": {
    "dev": "next dev",
    "dev:api": "wrangler dev --port 8787",
    "build": "next build",
    "deploy:api": "wrangler deploy",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@audio/decode-dts": "^1.0.0",
    "@audio/decode-eac3": "^1.0.0",
    "fast-xml-parser": "5.3.0",
    "fflate": "0.8.2",
    "hls.js": "1.6.13",
    "next": "15.5.29",
    "qrcode": "1.5.4",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "wrangler": "^4.40.3"
  },
  "engines": {
    "node": ">=20"
