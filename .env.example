# ── Frontend (GitHub Pages build) ─────────────────────────────────────────────
# Optional backend URL. Leave empty for "direct mode" (API code runs in the browser).
# Local Worker for testing: `npm run dev:api` → http://localhost:8787
NEXT_PUBLIC_API_BASE=
# Sub-path for project pages (set automatically by the Pages workflow).
NEXT_PUBLIC_BASE_PATH=

# ── API Worker ────────────────────────────────────────────────────────────────
# Non-secret options live in wrangler.toml [vars]. Secrets go in
# `npx wrangler secret put NAME` (production) or a `.dev.vars` file (local dev):
#   TMDB_API_KEY, REALDEBRID_API_KEY, TORBOX_API_KEY, DEBRIDLINK_API_KEY,
#   OPENSUBTITLES_API_KEY, SUBDL_API_KEY, TORZNAB_URL, TORZNAB_API_KEY, ACCESS_TOKEN
