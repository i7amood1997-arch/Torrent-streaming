# All keys are optional server-side defaults. Users can also enter their own
# keys in Settings; those are sent per-request in headers and never stored server-side.

# TMDB — v4 "API Read Access Token" (preferred) or v3 API key
TMDB_API_KEY=

# Debrid providers (server default; per-user keys in Settings override these)
REALDEBRID_API_KEY=
TORBOX_API_KEY=
DEBRIDLINK_API_KEY=

# Subtitles
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USER_AGENT=TorrentStreamingPWA v0.1
SUBDL_API_KEY=

# Indexers — comma separated list of enabled sources:
#   torrentio, torznab, yts, eztv, apibay
INDEXERS=torrentio,torznab,yts,eztv
TORRENTIO_URL=https://torrentio.strem.fun
# Jackett: http://host:9117/api/v2.0/indexers/all/results/torznab
# Prowlarr: http://host:9696/{indexerId}/api
TORZNAB_URL=
TORZNAB_API_KEY=
YTS_URL=https://yts.mx
EZTV_URL=https://eztvx.to
APIBAY_URL=https://apibay.org
